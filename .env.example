# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 마이그레이션 실행용. **Session pooler** 주소를 쓴다 —
# Direct 연결은 IPv6 전용이라 대부분의 로컬 환경에서 붙지 않는다.
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Media Server (MediaMTX)
#
# 아래 셋은 `pnpm certs:dev`가 현재 LAN IP로 자동 갱신한다.
# Wi-Fi가 바뀌면 다시 실행할 것.
#
# HLS는 8890, WebRTC는 8891이다 — macOS 기본 httpd/mysqld가 8888·8889를 쓴다.
NEXT_PUBLIC_HLS_BASE_URL=https://localhost:8890
NEXT_PUBLIC_WHEP_BASE_URL=https://localhost:8891
# 대시보드가 OBS에 안내하는 RTMP 송출 주소
NEXT_PUBLIC_RTMP_URL=rtmp://localhost:1935
# 관리 API. 루프백에만 바인딩된다 (외부 노출 금지)
MEDIAMTX_API_URL=http://127.0.0.1:9997
# 썸네일 워커가 프레임을 읽어갈 내부 주소
MEDIA_HLS_INTERNAL_URL=http://127.0.0.1:8890

# WebSocket (채팅 서버)
NEXT_PUBLIC_WS_URL=https://localhost:3001
CHAT_PORT=3001
# 채팅 서버가 받아줄 origin 목록 (쉼표 구분)
CORS_ORIGIN=https://localhost:3000

# 공유 링크·OG 메타데이터의 기준 URL
APP_URL=https://localhost:3000

# 개발용 TLS. `pnpm certs:dev`가 만든 mkcert 인증서를 앱·채팅·미디어가 공유한다.
# HTTPS는 선택이 아니다 — getUserMedia가 secure context를 요구하고,
# HTTPS 페이지에서 http WHIP 호출은 mixed content로 차단된다.
TLS_CERT=certs/dev.crt
TLS_KEY=certs/dev.key

# Stripe (포인트 충전)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# 토스페이먼츠 지급대행 (환전)
#
# 주의: 결제 키와 다르다. 키 중간 글자로 구분한다.
#   결제 키          test_gck_... / test_gsk_...  ← 지급대행에 쓸 수 없음
#   API 개별 연동 키  test_ck_...  / test_sk_...   ← 이걸 써야 한다
# 클라이언트 키는 브라우저 SDK용이라 지급대행에는 아예 필요 없다.
#
#   TOSS_SECRET_KEY          API 개별 연동 키 > 시크릿 키 (test_sk_...). Basic 인증용
#   TOSS_PAYOUT_SECURITY_KEY API 개별 키 > 보안 키. 64자 Hex. 시크릿 키와 별개로 발급된다.
#                            요청 본문 JWE 암호화와 웹훅 서명 검증에 쓴다.
#
# 지급대행은 별도 "서비스 이용 신청"이 필요하다. 신청 전에는 키가 있어도 403/404가 난다.
# `pnpm payout:check`로 지금 상태를 확인할 수 있다.
# 둘이 비어 있으면 환전 UI는 "미설정" 안내만 띄우고 나머지는 그대로 동작한다.
TOSS_SECRET_KEY=
TOSS_PAYOUT_SECURITY_KEY=

# 환전 정책 (미설정 시 기본값 사용)
PAYOUT_FEE_RATE=0.2          # 플랫폼 수수료율
PAYOUT_WITHHOLDING_RATE=0.033 # 사업소득 원천징수 (개인·개인사업자만)
PAYOUT_HOLD_DAYS=14          # 후원 받은 뒤 환전 가능해지기까지의 대기일
PAYOUT_MIN_AMOUNT=10000      # 최소 환전 금액

# 썸네일 워커 (미설정 시 기본값 사용)
THUMBNAIL_INTERVAL_MS=30000
THUMBNAIL_CONCURRENCY=3
