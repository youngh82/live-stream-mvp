{
  "name": "live-stream-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-cert certs/dev.crt --experimental-https-key certs/dev.key",
    "dev:all": "concurrently -n next,chat,thumb,redis,media,stripe -c blue,green,cyan,red,yellow,magenta \"pnpm dev\" \"pnpm chat:dev\" \"pnpm thumb:dev\" \"pnpm infra:up\" \"pnpm media:dev\" \"pnpm stripe:listen\"",
    "stripe:listen": "stripe listen --skip-verify --forward-to https://localhost:3000/api/webhooks/stripe",
    "dev:app": "concurrently -k -n next,chat -c blue,green \"pnpm dev\" \"pnpm chat:dev\"",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "media:dev": "mediamtx infra/mediamtx.yml",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "chat:dev": "tsx src/server/chat.ts",
    "thumb:dev": "tsx src/server/thumbnailer.ts",
    "payout:check": "tsx scripts/check-payout-keys.ts",
    "verify:payout": "tsx scripts/verify-payout.ts",
    "verify:security": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" tsx scripts/verify-security.ts",
    "dev:http": "next dev",
    "certs:dev": "bash scripts/setup-dev-tls.sh"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
