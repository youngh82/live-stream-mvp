# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어 있는 템플릿은 저장소에 있어야 한다
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# TLS 개발용 인증서/개인키 (M-05)
auto.crt
auto.key
*.key
*.crt

# mkcert 개발 인증서
certs/

# 데모 스크린샷용 스트림 키 (scripts/seed-demo.ts)
.demo-streams
.demo-broadcast.pids
.demo-logs/

